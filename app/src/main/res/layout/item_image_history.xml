<?xml version="1.0" encoding="utf-8"?>
<!-- History list item: thumbnail centered, below it [share] FGI code [delete].
     Share is a placeholder icon (non-functional for now). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/imgItemThumb"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:adjustViewBounds="false"
        android:scaleType="centerInside"
        android:src="@drawable/add_circle" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnItemShare"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Share"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#9CA3AF" />

        <TextView
            android:id="@+id/txtItemFgiCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="monospace"
            android:text="FGI1:X31.6;Y27.2;W26.4;R90;A60;S1080x2400"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Row separator: hidden for the last row (and when there is only one row) by the adapter.
         Inset from each edge by the device corner radius (set in code). -->
    <View
        android:id="@+id/divItemSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/history_divider" />
</LinearLayout>